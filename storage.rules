rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /products/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /chats/{chatId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() || isAdmin();
    }
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
